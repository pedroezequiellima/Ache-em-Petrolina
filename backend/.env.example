# Copie este arquivo para .env e ajuste se precisar:  cp .env.example .env

# Porta da API
PORT=3000

# Credenciais do Postgres usadas pelo docker-compose.yml
POSTGRES_USER=ache
POSTGRES_PASSWORD=ache123
POSTGRES_DB=ache_petrolina
POSTGRES_PORT=5433

# URL de conexão usada pelo Prisma
DATABASE_URL="postgresql://ache:ache123@localhost:5433/ache_petrolina?schema=public"

# Horas que uma reserva fica válida até expirar
RESERVA_VALIDADE_HORAS=24
