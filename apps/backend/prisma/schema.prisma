// Schema do banco do Ache em Petrolina.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Situação do estoque exibida no catálogo
enum StatusEstoque {
  DISPONIVEL
  POUCAS_UNIDADES
  ESGOTADO
}

// Ciclo de vida de uma reserva
enum StatusReserva {
  NOVA
  CONFIRMADA
  RETIRADA
  CANCELADA
  EXPIRADA
}

// Quem pode entrar na área de gestão
enum Papel {
  ADMIN // cadastra bairros, categorias, lojas e lojistas
  LOJISTA // gerencia só a própria loja
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senhaHash    String // bcrypt: nunca guardamos a senha em texto
  papel        Papel    @default(LOJISTA)
  lojaId       Int? // obrigatório para LOJISTA, vazio para ADMIN
  loja         Loja?    @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tokensRedefinicao TokenRedefinicaoSenha[]

  @@index([lojaId])
  @@map("usuarios")
}

// "Esqueci minha senha": código de uso único, com validade curta.
// Guardamos só o hash (SHA-256): quem ler o banco não consegue usar o código.
model TokenRedefinicaoSenha {
  id        Int       @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  @@index([usuarioId])
  @@map("tokens_redefinicao_senha")
}

model Bairro {
  id    Int    @id @default(autoincrement())
  nome  String @unique
  slug  String @unique // Usado no filtro do front, ex: "areia-branca"
  lojas Loja[]

  @@map("bairros")
}

model Loja {
  id              Int           @id @default(autoincrement())
  slug            String        @unique
  nome            String
  descricao       String?
  whatsapp        String // Só dígitos com DDI+DDD, ex: 5587999999999 (usado no link wa.me)
  telefone        String?
  email           String?
  instagram       String?
  endereco        String
  cep             String?
  bairroId        Int
  bairro          Bairro        @relation(fields: [bairroId], references: [id], onDelete: Restrict)
  logoUrl         String?
  avaliacao       Float? // Nota média, ex: 4.7
  totalAvaliacoes Int           @default(0)
  horarios        HorarioLoja[]
  produtos        Produto[]
  usuarios        Usuario[]
  criadoEm        DateTime      @default(now())
  atualizadoEm    DateTime      @updatedAt

  @@index([bairroId])
  @@map("lojas")
}

// Um registro por dia em que a loja abre. Dia sem registro = fechado.
model HorarioLoja {
  id        Int    @id @default(autoincrement())
  lojaId    Int
  loja      Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  diaSemana Int // 0 = domingo ... 6 = sábado (mesmo padrão do JavaScript)
  abre      String // "08:00"
  fecha     String // "18:00"

  @@unique([lojaId, diaSemana])
  @@map("horarios_loja")
}

model Categoria {
  id       Int       @id @default(autoincrement())
  nome     String    @unique
  slug     String    @unique // Versão para URL, ex: "moda-feminina"
  produtos Produto[]

  @@map("categorias")
}

model Produto {
  id            Int           @id @default(autoincrement())
  slug          String        @unique // Usado na URL do front: /produto/<slug>
  nome          String
  marca         String?
  descricao     String?
  detalhes      String[] // Linhas tipo "Tamanhos: 38 ao 44"
  preco         Decimal       @db.Decimal(10, 2)
  precoAntigo   Decimal?      @db.Decimal(10, 2) // Preço "de" riscado, quando há promoção
  fotos         String[] // URLs ou caminhos (ex: /mock/calcados-1.svg)
  tags          String[] // Palavras extras para a busca
  destaque      Boolean       @default(false)
  statusEstoque StatusEstoque @default(DISPONIVEL)
  lojaId        Int
  loja          Loja          @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  categoriaId   Int
  categoria     Categoria     @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  reservas      Reserva[]
  criadoEm      DateTime      @default(now())
  atualizadoEm  DateTime      @updatedAt

  @@index([lojaId])
  @@index([categoriaId])
  @@map("produtos")
}

model Reserva {
  id              Int           @id @default(autoincrement())
  nomeCliente     String
  whatsappCliente String
  quantidade      Int
  aceiteLgpd      Boolean // Cliente aceitou as regras/LGPD no formulário
  status          StatusReserva @default(NOVA)
  expiraEm        DateTime // Prazo para retirada; depois disso vira EXPIRADA
  produtoId       Int
  produto         Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  criadoEm        DateTime      @default(now())
  atualizadoEm    DateTime      @updatedAt

  @@index([produtoId])
  @@index([status])
  @@map("reservas")
}
