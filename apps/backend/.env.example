# Copie este arquivo para .env e ajuste se precisar:  cp .env.example .env

# Porta da API (o front Next.js usa a 3000)
PORT=3001

# Credenciais do Postgres usadas pelo docker-compose.yml
POSTGRES_USER=ache
POSTGRES_PASSWORD=ache123
POSTGRES_DB=ache_petrolina
POSTGRES_PORT=5433

# URL de conexão usada pelo Prisma
DATABASE_URL="postgresql://ache:ache123@localhost:5433/ache_petrolina?schema=public"

# Horas que uma reserva fica válida até expirar
RESERVA_VALIDADE_HORAS=24

# Endereço do front liberado no CORS
FRONTEND_URL=http://localhost:3000

# ---- Login (JWT) ----
# Segredo que assina os tokens. Precisa ter 32+ caracteres e NUNCA ir pro Git.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres
# Validade do token (ex: 1h, 8h, 1d)
JWT_EXPIRA_EM=1d

# Admin criado pelo seed (npm run db:seed)
ADMIN_EMAIL=admin@ache.local
ADMIN_SENHA=troque-esta-senha
# Senha dos lojistas de exemplo criados pelo seed (só desenvolvimento)
SEED_SENHA_LOJISTA=lojista-dev-123
