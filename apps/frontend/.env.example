NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Endereço da API (apps/backend). Só o servidor do Next usa: não vai para o navegador.
API_URL=http://localhost:3001
# Mesmo valor do FRONTEND_TOKEN do apps/backend/.env: libera as leituras do site do limite
# de requisições por IP da API. Só o servidor do Next usa; NUNCA no Git.
FRONTEND_TOKEN=
