{
  "name": "ache-em-petrolina",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend --",
    "build": "npm run build -w frontend --",
    "start": "npm run start -w frontend --",
    "lint": "npm run lint -w frontend --",
    "format": "npm run format -w frontend --",
    "format:check": "npm run format:check -w frontend --",
    "dev:backend": "npm run start:dev -w backend",
    "build:backend": "npm run build -w backend",
    "test:backend": "npm run test -w backend",
    "lint:backend": "npm run lint -w backend",
    "db:up": "npm run db:up -w backend",
    "db:down": "npm run db:down -w backend"
  }
}
